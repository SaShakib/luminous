NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Prefer a single connection string in deployed environments.
DATABASE_URL=postgres://avnadmin:password@host:28451/defaultdb?sslmode=require

# Or provide individual pg fields.
PGHOST=host
PGPORT=28451
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=password

# Aiven usually requires the CA certificate.
# Download it as ca.pem and point this variable at the file.
PG_SSL_CA_PATH=./ca.pem
